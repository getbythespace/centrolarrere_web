# =====================================================
# LARRÈRE — variables de entorno
# =====================================================

# --- Sitio -------------------------------------------
# IMPORTANTE: en producción esto tiene que ser el dominio real.
# Si queda en localhost, el sitemap, el robots.txt y los datos
# estructurados de schema.org publican URLs de localhost.
NEXT_PUBLIC_SITE_URL=https://larrere.cl

# --- Supabase (requerido) ----------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# --- Medición y pauta --------------------------------
# Meta Pixel: sin esto los anuncios de Instagram/Facebook NO pueden
# optimizar hacia gente que escribe por WhatsApp. Es la variable que
# más impacta el retorno de la pauta.
# Se obtiene en: Meta Business Suite → Administrador de eventos → Orígenes de datos
NEXT_PUBLIC_META_PIXEL_ID=

# Google Tag Manager (opcional). Si lo configuras, GA4 se declara
# desde GTM y no hace falta NEXT_PUBLIC_GA4_ID.
NEXT_PUBLIC_GTM_ID=

# GA4 directo (opcional). Sólo se usa si NO hay GTM: con los dos
# configurados se duplicarían los pageviews.
NEXT_PUBLIC_GA4_ID=

# --- Reglas de negocio -------------------------------
TZ=America/Santiago
HOLD_DURATION_HOURS=2
MINIMUM_BOOKING_HOURS=12
BUFFER_MINUTES=15
# Miércoles = 3; 17:30 en decimal = 17.5
MEDICAL_EVAL_DAY=3
MEDICAL_EVAL_MIN_HOUR=17.5

# --- Admin -------------------------------------------
ADMIN_EMAIL=
ADMIN_ALLOWED_EMAILS=

# --- Datos de transferencia (se muestran al reservar) -
BANK_NAME=
ACCOUNT_NUMBER=
ACCOUNT_HOLDER=
ACCOUNT_RUT=

# --- Email (opcional) --------------------------------
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=reservas@larrere.cl
